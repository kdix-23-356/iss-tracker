diff --git a/src/utils/orbitalLogic.test.ts b/src/utils/orbitalLogic.test.ts
index 0000000..0000002 100644
--- a/src/utils/orbitalLogic.test.ts
+++ b/src/utils/orbitalLogic.test.ts
@@ -1,3 +1,70 @@
+import { describe, it, expect } from 'vitest';
+import { wrapLon, shortestLonDelta, lerpLon } from './orbitalLogic';
+
+describe('wrapLon', () => {
+  it('normalizes into [-180, 180)', () => {
+    expect(wrapLon(0)).toBe(0);
+    expect(wrapLon(180)).toBe(-180);     // 180 は -180 に落ちる
+    expect(wrapLon(190)).toBe(-170);
+    expect(wrapLon(-181)).toBe(179);
+    expect(wrapLon(540)).toBe(-180);
+    expect(wrapLon(-540)).toBe(-180);
+  });
+});
+
+describe('shortestLonDelta', () => {
+  it('across the dateline', () => {
+    // 179 -> -179 は -2（西回りが最短）
+    expect(shortestLonDelta(179, -179)).toBe(-2);
+    // -179 -> 179 は +2（東回りが最短）
+    expect(shortestLonDelta(-179, 179)).toBe(2);
+  });
+
+  it('small deltas keep their sign', () => {
+    expect(shortestLonDelta(10, 12)).toBe(2);
+    expect(shortestLonDelta(12, 10)).toBe(-2);
+  });
+
+  it('wraps into [-180,180]', () => {
+    expect(shortestLonDelta(0, 181)).toBe(-179);
+    expect(shortestLonDelta(0, -181)).toBe(179);
+  });
+});
+
+describe('lerpLon', () => {
+  it('interpolates shortest path across dateline', () => {
+    const mid = lerpLon(179, -179, 0.5);
+    // 中間は理論上 ±180 近傍に来る。数値誤差を許容
+    expect(Math.abs(Math.abs(mid) - 180)).toBeLessThan(1e-9);
+  });
+
+  it('no-cross simple lerp', () => {
+    expect(lerpLon(10, 20, 0.5)).toBe(15);
+  });
+});
+