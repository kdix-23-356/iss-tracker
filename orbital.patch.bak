cat > orbital.patch <<'PATCH'
diff --git a/src/utils/orbitalLogic.ts b/src/utils/orbitalLogic.ts
index 1111111..2222222 100644
--- a/src/utils/orbitalLogic.ts
+++ b/src/utils/orbitalLogic.ts
@@ -1,3 +1,73 @@
+/**
+ * 経度を [-180, 180) に正規化
+ * 例:  190  -> -170
+ *     -181 ->  179
+ */
+export function wrapLon(lon: number): number {
+  // JSの%は剰余なので、負も考慮して二重mod
+  return ((lon + 180) % 360 + 360) % 360 - 180;
+}
+
+/**
+ * 最短回転の経度差（-180〜+180）
+ * 例: 179 -> -179 は -2、 -179 -> 179 は +2
+ */
+export function shortestLonDelta(from: number, to: number): number {
+  const a = wrapLon(from);
+  const b = wrapLon(to);
+  let d = b - a;        // -360〜+360 の可能性
+  if (d > 180)  d -= 360;
+  if (d < -180) d += 360;
+  return d;             // -180〜+180
+}
+
+/**
+ * 経度の最短回転補間（0<=t<=1）
+ * from を起点に、to へ最短回転で t 補間した値を [-180,180) で返す
+ */
+export function lerpLon(from: number, to: number, t: number): number {
+  const d = shortestLonDelta(from, to);
+  return wrapLon(from + d * t);
+}
+
+/** 緯度の線形補間 */
+export function lerpLat(from: number, to: number, t: number): number {
+  return from + (to - from) * t;
+}
+
+/** 高度[m]の線形補間 */
+export function lerpAltM(from: number, to: number, t: number): number {
+  return from + (to - from) * t;
+}
+
+// 既存の公開APIや型、関数がこのファイル内にある前提で、
+// 追加の export を壊さない（＝差分最小）形で追記しました。
+// 既存関数（calculateIssTelemetry / calculateOrbitPoints 等）はそのままでOK。